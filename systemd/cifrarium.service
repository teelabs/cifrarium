[Unit]
Description=Cifrarium local encrypted configuration vault

[Service]
Type=simple
UMask=0077
NoNewPrivileges=yes
Environment=XDG_CONFIG_HOME=%h/.config
EnvironmentFile=-%h/.config/cifrarium/daemon.env
ExecStart=%h/.local/bin/cifrarium daemon
Restart=on-failure
RestartSec=30s

[Install]
WantedBy=default.target
