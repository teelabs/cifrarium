{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "product", "version", "releases"],
  "properties": {
    "schema": { "const": 1 },
    "product": { "const": "cifrarium" },
    "version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" },
    "releases": {
      "type": "array",
      "minItems": 2,
      "maxItems": 2,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["architecture", "archive", "sha256", "bundle"],
        "properties": {
          "architecture": { "enum": ["linux-amd64", "linux-arm64"] },
          "archive": { "type": "string", "pattern": "^cifrarium-[0-9]+\\.[0-9]+\\.[0-9]+-linux-(amd64|arm64)\\.tar\\.gz$" },
          "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
          "bundle": { "type": "string", "pattern": "^cifrarium-[0-9]+\\.[0-9]+\\.[0-9]+-linux-(amd64|arm64)\\.tar\\.gz\\.bundle$" }
        }
      }
    }
  }
}
